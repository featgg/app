{
  "@@locale": "en",
  "errorNetwork": "Check your connection and try again.",
  "@errorNetwork": {
    "description": "Shown when a request fails due to no connectivity, DNS, TLS, or timeout."
  },
  "errorServer": "Something went wrong on our end. Please try again.",
  "@errorServer": {
    "description": "Shown when the server returns a non-2xx response or an error envelope."
  },
  "errorAuth": "Your session has expired. Please sign in again.",
  "@errorAuth": {
    "description": "Shown when the user's session is invalid or expired and re-authentication is required."
  },
  "errorInput": "Some details look incorrect. Please review and try again.",
  "@errorInput": {
    "description": "Shown when the server rejects the request due to invalid client-supplied input."
  },
  "errorUnexpected": "Something unexpected happened. Please try again.",
  "@errorUnexpected": {
    "description": "Shown for any fault the error mapper cannot classify into a more specific subtype."
  },
  "errorNotImplemented": "This feature isn't available yet.",
  "@errorNotImplemented": {
    "description": "Shown when a feature stub returns NotImplemented because no integration brief exists yet."
  },
  "errorAuthRateLimited": "Too many attempts. Please try again in about a minute.",
  "@errorAuthRateLimited": {
    "description": "Shown when the auth service rate-limits a send or verify request (HTTP 429 class). The UI disables the rate-limited action and backs off for about a minute. Wording is approximate because the server window is not known on the client."
  },
  "errorAvatarRejected": "This image can't be used as a profile picture. Please choose a different one.",
  "@errorAvatarRejected": {
    "description": "Shown when the server's moderation provider flags the uploaded avatar image. Generic copy — raw category tokens are never displayed."
  },
  "errorAvatarUnavailable": "Couldn't process your image right now. Please try again later.",
  "@errorAvatarUnavailable": {
    "description": "Shown when the moderation provider is unavailable or returns an unexpected error. The avatar is unchanged; the user can retry."
  },
  "errorAvatarRateLimited": "You're uploading too quickly. Please try again shortly.",
  "@errorAvatarRateLimited": {
    "description": "Shown when the avatar upload endpoint returns 429 (rate limited). Generic fallback — the countdown copy is composed in the widget when retry_after seconds are known."
  },
  "errorAvatarProcessing": "Couldn't process that image. Please choose a different one.",
  "@errorAvatarProcessing": {
    "description": "Shown when the local image decode or crop step fails before any upload attempt."
  },
  "profileAvatarCooldownCountdown": "Try again in {time}",
  "@profileAvatarCooldownCountdown": {
    "description": "Avatar upload affordance label while the rate-limit cooldown window is active and the remaining seconds are known. {time} is formatted as m:ss.",
    "placeholders": {
      "time": {
        "type": "String"
      }
    }
  },
